#!/bin/bash
# Sets the Chamows password everywhere it is used: the Linux user (sudo),
# the browser login (nginx) and the desktop (VNC, also used by RDP).
# Reads the password from stdin so it never appears in the process list.
set -euo pipefail
umask 077

USER_NAME=chamows
IFS= read -r PW || true
if [ "${#PW}" -lt 8 ]; then
  echo "chamows-set-password: la contraseña debe tener al menos 8 caracteres" >&2
  exit 1
fi
case "$PW" in
  *:*) echo "chamows-set-password: la contraseña no puede contener ':'" >&2; exit 1 ;;
esac

printf '%s:%s\n' "$USER_NAME" "$PW" | chpasswd

install -d -m 0755 /etc/chamows
HASH=$(printf '%s' "$PW" | openssl passwd -6 -stdin)
printf '%s:%s\n' "$USER_NAME" "$HASH" > /etc/chamows/htpasswd.new
chown root:www-data /etc/chamows/htpasswd.new
chmod 0640 /etc/chamows/htpasswd.new
mv -f /etc/chamows/htpasswd.new /etc/chamows/htpasswd

VNC_DIR="/home/$USER_NAME/.config/tigervnc"
install -d -m 0700 -o "$USER_NAME" -g "$USER_NAME" "/home/$USER_NAME/.config" "$VNC_DIR"
printf '%s\n' "$PW" | tigervncpasswd -f > "$VNC_DIR/passwd.new"
chown "$USER_NAME:$USER_NAME" "$VNC_DIR/passwd.new"
chmod 0600 "$VNC_DIR/passwd.new"
mv -f "$VNC_DIR/passwd.new" "$VNC_DIR/passwd"

echo "chamows-set-password: contraseña actualizada"
