# Chamows: escritorio en el navegador (noVNC) detrás de HTTPS + contraseña.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/chamows/tls/cert.pem;
    ssl_certificate_key /etc/chamows/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic           "Chamows";
    auth_basic_user_file /etc/chamows/htpasswd;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    root /usr/share/novnc;

    location = / {
        return 302 /vnc.html?autoconnect=1&resize=remote&reconnect=1&path=websockify;
    }

    location /websockify {
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }
}
